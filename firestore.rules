rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function chatMember(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    function callMember(callId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.keys().hasOnly(['members', 'lastMessage', 'createdAt', 'updatedAt']);
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if chatMember(chatId);
        allow create: if chatMember(chatId)
          && request.resource.data.keys().hasOnly(['text', 'authorUid', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /calls/{callId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participants || request.auth.uid == resource.data.calleeUid);
      allow create: if signedIn()
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.calleeUid in request.resource.data.participants
        && request.resource.data.keys().hasOnly(['callerUid', 'calleeUid', 'callerName', 'video', 'status', 'participants', 'createdAt']);
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer', 'answer', 'status']);
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;

      match /{signalCollection}/{candidateId} {
        allow read, create: if callMember(callId)
          && signalCollection in ['offerCandidates', 'answerCandidates'];
        allow update, delete: if false;
      }
    }
  }
}

